# =============================================
# The Craft Beer Brief Essentials — Environment Variables
# =============================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to GitHub — it is already in .gitignore.
# Variables starting with VITE_ are exposed to the browser.
# Variables WITHOUT VITE_ prefix are server-side only (Supabase Edge Functions).

# --- Supabase ---
# Found in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key — NEVER expose this to the browser, only used in Edge Functions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Stripe ---
# Found in: Stripe Dashboard → Developers → API Keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here
STRIPE_SECRET_KEY=sk_test_your-key-here
# Found after running: stripe listen --forward-to localhost:54321/functions/v1/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# --- Stripe Price IDs ---
# Create these in Stripe Dashboard → Products → Add Product
VITE_STRIPE_MONTHLY_PRICE_ID=price_your-monthly-price-id
VITE_STRIPE_ANNUAL_PRICE_ID=price_your-annual-price-id

# --- Beehiiv ---
# Found in: Beehiiv Dashboard → Settings → Integrations → API
BEEHIIV_API_KEY=your-beehiiv-api-key-here

# --- Admin ---
# Your email address — grants access to the admin panel
VITE_ADMIN_EMAIL=twbobbercycles@gmail.com
